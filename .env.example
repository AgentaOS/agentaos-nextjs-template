# Public HTTPS address of this app. AgentaOS only redirects buyers to https URLs,
# so in development use your tunnel URL (for example https://abc123.ngrok-free.app).
APP_URL=https://your-tunnel.ngrok-free.app

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database. A local SQLite file by default. On Vercel, use a Turso (libSQL) URL and token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# AgentaOS. A sk_test_ key runs everything in test mode, a sk_live_ key in live mode.
# Dashboard: Developers > API keys.
AGENTAOS_API_KEY=sk_test_
# Dashboard: Settings > Developers > Webhooks > Reveal signing secret.
AGENTAOS_WEBHOOK_SECRET=whsec_

# Link IDs of your products (product page > Copy link ID, a UUID).
AGENTAOS_LINK_STARTER=
AGENTAOS_LINK_PRO=
AGENTAOS_LINK_LIFETIME=
